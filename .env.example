# Environment & Application Config
ENVIRONMENT=development
PROJECT_NAME="AI Interview Platform API"
API_V1_STR=/api/v1
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (PostgreSQL Async)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_interview_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interview_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars
JWT_SECRET_KEY=change-this-jwt-secret-key-for-production-min-32-chars
JWT_REFRESH_SECRET=change-this-jwt-refresh-secret-key-for-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External AI Integrations
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-pro

# CORS Settings (JSON list or comma-separated strings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
